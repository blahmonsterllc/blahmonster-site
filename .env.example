# Copy to .env.local for Next dev. In Cloudflare Pages, set the same keys under Settings → Environment variables.

# Session signing (use openssl rand -base64 32 or similar — at least 24 characters)
BLOG_SESSION_SECRET=replace-with-long-random-string

# Preferred for production: run `node scripts/hash-admin-password.mjs "your-password"` and paste the line below.
# BLOG_ADMIN_PASSWORD_PBKDF2=pbkdf2$310000$...

# Dev-only fallback (min 14 characters). Do not use short passwords in production.
# BLOG_ADMIN_PASSWORD=
